# HAOMI API Tools — Environment Variables
# Isi SEMUA di hosting (Netlify/Vercel → Site settings → Environment variables)

UPSTREAM_API_KEY=          # key master upstream (rahasia!)
HAOMI_OWNER_KEY=           # owner key format Hao-xxx-xxx-xxx (rahasia!)
PAY_API_KEY=               # key gateway pembayaran QRIS (rahasia!)
OWNER_WA=628xxxxxxxxxx     # nomor WA owner (bukan rahasia, kontak publik)
UPSTASH_REDIS_REST_URL=    # opsional: untuk data permanen
UPSTASH_REDIS_REST_TOKEN=  # opsional: pasangan URL di atas
FREE_DAILY_LIMIT=100       # opsional: limit user free
